{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "vueIndentScriptAndStyle": false,
  "endOfLine": "lf",
  "sortImports": {
    "newlinesBetween": false,
    "groups": ["vue", "external", "internal", { "newlinesBetween": true }, "type"],
    "customGroups": [
      {
        "groupName": "vue",
        "elementNamePattern": ["vue"]
      }
    ],
    "internalPattern": ["@/"]
  }
}
